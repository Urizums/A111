 def visible_text(page, selector):
     return page.locator(selector).inner_text().strip()
+
+def wait_for_state(page, expression, timeout=3000):
+    predicate = f"() => Boolean({expression})"
+    try:
+        page.wait_for_function(predicate, timeout=timeout)
+    except Exception:
+        pass
+    return bool(page.evaluate(predicate))
+
+def keyboard_confirm(page, trigger_selector, applied_expression):
+    page.locator(trigger_selector).focus()
+    page.keyboard.press('Enter')
+    page.locator('#confirm').wait_for(state='visible', timeout=3000)
+    initial_focus = page.evaluate('document.activeElement.id')
+    page.keyboard.press('Tab')
+    confirm_focus = page.evaluate('document.activeElement.id')
+    page.keyboard.press('Enter')
+    applied = wait_for_state(page, applied_expression, timeout=1800)
+    return {
+        'initial_focus': initial_focus,
+        'confirm_focus': confirm_focus,
+        'dialog_closed': not page.evaluate("document.querySelector('#confirm').open"),
+        'applied': applied,
+    }
+
+def pointer_confirm_fallback(page, trigger_selector, applied_expression):
+    if wait_for_state(page, applied_expression, timeout=50):
+        return False
+    if not page.evaluate("document.querySelector('#confirm').open"):
+        page.locator(trigger_selector).focus()
+        page.keyboard.press('Enter')
+        page.locator('#confirm').wait_for(state='visible', timeout=3000)
+    page.locator('#confirm-ok').click()
+    return wait_for_state(page, applied_expression, timeout=4000)
 
