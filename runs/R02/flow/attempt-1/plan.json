      },
      "expected": {
        "result": {
          "borrower_id": "B-overdue",
          "book_id": "BK-overdue",
          "decision": "staff_review",
          "renewal_days": 0,
          "reasons": [
            "overdue"
          ]
        }
      },
      "expected_status": "completed",
      "criteria": [
        "policy",
        "protocol"
      ],
      "required": true
    },
    {
      "id": "quota",
      "inputs": {
