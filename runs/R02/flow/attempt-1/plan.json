    {
      "id": "policy",
      "kind": "machine",
      "required": true,
      "assertion": "Exact decision, days, IDs and reasons match the explicit renewal policy."
    },
    {
      "id": "protocol",
      "kind": "machine",
      "required": true,
      "assertion": "Strict input/output shapes and stale response protection preserve the checkpoint."
    }
  ],
  "cases": [
